{
  "name": "pharmina",
  "productName": "PHARMINA",
  "version": "0.1.0",
  "description": "Logiciel de gestion de pharmacie : ventes, stock, lots, comptes clients et caisse.",
  "author": {
    "name": "PHARMINA"
  },
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "dist:win": "bash scripts/installateur.sh",
    "test": "electron tests/schema.test.js && electron tests/seed.test.js && npm run test:e2e",
    "test:e2e": "electron-vite build && electron out/main/e2e.js",
    "apercu": "bash scripts/apercu.sh",
    "icone": "electron scripts/icone.js",
    "repertoire": "electron scripts/repertoire.js",
    "demo": "electron-vite build && electron out/main/demonstration.js"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^41.10.7",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "^12.11.1"
  }
}
